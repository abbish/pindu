<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 与 Tauri 生成的 Info.plist 合并：开发语言为简体中文，系统控件（右键菜单、文件对话框等）显示中文 -->
  <key>CFBundleDevelopmentRegion</key>
  <string>zh_CN</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>zh_CN</string>
    <string>en</string>
  </array>
  <!-- 跟读练习录自己的声音（只在本机回放对比，不上传） -->
  <key>NSMicrophoneUsageDescription</key>
  <string>跟读练习时录下你的声音，用来和原声对比回放。录音只在本机，不会上传。</string>
  <!-- 设备互传：在同一网络里发现别的拼读、配对与传送（macOS 15 起没有这项说明会被系统静默拦截） -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>在同一网络里找到你的其他电脑上的拼读，配对后互相传送素材和学习计划。</string>
</dict>
</plist>
