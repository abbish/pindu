{
  "name": "pindu-app",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "npm run clean:dist && npm run clean:target && npm run clean:cache",
    "clean:all": "npm run clean && npm run clean:deps",
    "clean:dist": "rimraf dist",
    "clean:target": "rimraf src-tauri/target",
    "clean:cache": "rimraf node_modules/.vite && rimraf node_modules/.cache && rimraf .vite",
    "clean:deps": "rimraf node_modules agent/node_modules",
    "clean:logs": "rimraf *.log && rimraf logs",
    "tauri": "tauri",
    "agent:install": "npm --prefix agent install",
    "agent:build": "node agent/scripts/build.mjs",
    "agent:test": "npm --prefix agent test",
    "tauri:dev": "node agent/scripts/build.mjs && tauri dev",
    "package": "node scripts/package.mjs",
    "package:check": "node scripts/package.mjs --check",
    "package:exe": "node scripts/package.mjs --no-bundle",
    "package:mac-universal": "node scripts/package.mjs --target mac-universal",
    "package:mac-intel": "node scripts/package.mjs --target mac-intel",
    "package:mac-arm": "node scripts/package.mjs --target mac-arm",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --import ./scripts/test-resolve-hook.mjs --test \"src/**/*.test.ts\"",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.31.0",
    "globals": "^14.0.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
